---
import Base from '../layouts/Base.astro';
if (Astro.locals.user) return Astro.redirect('/dashboard');
const error = Astro.url.searchParams.get('error');
const name = Astro.url.searchParams.get('name') || '';
const email = Astro.url.searchParams.get('email') || '';
---
<Base title="Daftar" description="Buat akun gratis OnBoss Academy — simpan progres, absensi, dan kumpulkan sertifikat.">
  <div class="mx-auto flex max-w-md flex-col px-4 py-16 sm:px-0">
    <div class="rounded-3xl border border-line bg-surface p-8 shadow-sm">
      <h1 class="text-2xl font-extrabold tracking-tight">Buat akun gratis 🎓</h1>
      <p class="mt-1.5 text-sm text-muted">Simpan progres, ikuti absensi harian, dan dapatkan sertifikat.</p>
      {error && <div class="mt-4 rounded-xl border border-danger/30 bg-danger-soft px-4 py-3 text-sm font-semibold text-danger">{error}</div>}
      <form method="POST" action="/api/auth/register" class="mt-6 space-y-4">
        <div>
          <label class="mb-1.5 block text-sm font-bold" for="name">Nama Lengkap</label>
          <input id="name" name="name" required value={name} placeholder="Sari Wijaya" class="w-full rounded-xl border border-line bg-bg px-4 py-3 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-bold" for="email">Email</label>
          <input id="email" name="email" type="email" required value={email} placeholder="kamu@email.com" class="w-full rounded-xl border border-line bg-bg px-4 py-3 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-bold" for="password">Password <span class="font-medium text-muted">(min. 8 karakter)</span></label>
          <input id="password" name="password" type="password" required minlength="8" placeholder="••••••••" class="w-full rounded-xl border border-line bg-bg px-4 py-3 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
        </div>
        <button type="submit" class="w-full rounded-xl bg-primary py-3 text-sm font-bold text-white shadow-sm shadow-primary/30 hover:bg-primary-dark">Daftar Sekarang</button>
      </form>
      <p class="mt-6 text-center text-sm text-muted">Sudah punya akun? <a href="/login" class="font-bold text-primary hover:underline">Masuk</a></p>
    </div>
  </div>
</Base>
