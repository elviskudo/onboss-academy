---
import type { Language } from '../data/languages';
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
---
<a
  href={`/belajar/${lang.id}`}
  class="group relative flex flex-col gap-3 overflow-hidden rounded-2xl border border-line bg-surface p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-transparent hover:shadow-lg"
>
  <span class="absolute -right-6 -top-6 h-20 w-20 rounded-full opacity-10 transition group-hover:scale-125" style={`background:${lang.color}`}></span>
  <div class="flex items-center gap-3">
    <span class="flex h-11 w-11 items-center justify-center rounded-xl text-xl shadow-sm" style={`background:${lang.color}1A`}>{lang.icon}</span>
    <div>
      <div class="flex items-center gap-2">
        <h3 class="font-extrabold tracking-tight">{lang.name}</h3>
        {lang.popular && <span class="rounded-full bg-warn-soft px-2 py-0.5 text-[10px] font-bold uppercase text-warn">Populer</span>}
      </div>
      <p class="text-xs text-muted">{lang.category}</p>
    </div>
  </div>
  <p class="text-sm leading-6 text-muted">{lang.tagline}</p>
  <span class="mt-auto text-sm font-bold text-primary opacity-0 transition group-hover:opacity-100">Mulai belajar →</span>
</a>
