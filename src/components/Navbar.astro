---
interface Props {
  user: { id: string; email: string; name: string } | null;
}
const { user } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Beranda' },
  { href: '/belajar', label: 'Semua Bahasa' },
  { href: '/dashboard', label: 'Dashboard' },
];
function active(href: string) {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---
<header class="sticky top-0 z-50 border-b border-line/80 bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/logo.png" alt="" width="105" height="64" class="h-16 w-auto object-contain" />
    </a>
    <nav class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'rounded-lg px-3.5 py-2 text-sm font-semibold transition',
            active(l.href) ? 'bg-primary-soft text-primary-dark' : 'text-muted hover:bg-line/50 hover:text-ink',
          ]}
        >{l.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      {user ? (
        <div class="flex items-center gap-2">
          <a href="/dashboard" class="hidden text-sm font-semibold text-muted hover:text-ink sm:block">{user.name.split(' ')[0]}</a>
          <form method="POST" action="/api/auth/logout">
            <button type="submit" class="rounded-lg border border-line bg-surface px-3.5 py-2 text-sm font-semibold text-ink hover:border-ink/30">Keluar</button>
          </form>
        </div>
      ) : (
        <>
          <a href="/login" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-muted hover:text-ink">Masuk</a>
          <a href="/register" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-primary/30 hover:bg-primary-dark">Daftar Gratis</a>
        </>
      )}
      <button id="nav-toggle" class="rounded-lg p-2 text-ink hover:bg-line/50 md:hidden" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="nav-mobile" class="hidden border-t border-line bg-bg px-4 py-3 md:hidden">
    {links.map((l) => (
      <a href={l.href} class="block rounded-lg px-3 py-2.5 text-sm font-semibold text-ink hover:bg-line/50">{l.label}</a>
    ))}
  </nav>
</header>
<script>
  document.getElementById('nav-toggle')?.addEventListener('click', () => {
    document.getElementById('nav-mobile')?.classList.toggle('hidden');
  });
</script>
