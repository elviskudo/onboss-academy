---
import { chapterIdToSlug } from '../lib/progress';
import type { ChapterEntry } from '../lib/progress';

interface Props {
  langId: string;
  langName: string;
  chapters: ChapterEntry[];
  passed: Set<string>;
  currentId?: string;
}
const { langId, langName, chapters, passed, currentId } = Astro.props;
---
<aside class="tutorial-sidebar max-h-[40vh] w-full shrink-0 overflow-y-auto rounded-2xl border border-line bg-surface p-4 lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:w-64">
  <a href="/belajar" class="mb-3 block text-xs font-bold uppercase tracking-wider text-muted hover:text-primary">← Semua Bahasa</a>
  <h2 class="mb-3 border-b border-line pb-3 text-sm font-extrabold uppercase tracking-wider text-ink">{langName}</h2>
  <nav class="space-y-0.5">
    {chapters.map((c, i) => {
      const unlocked = true;
      const done = passed.has(c.id);
      const active = c.id === currentId;
      const slug = chapterIdToSlug(langId, c.id);
      return unlocked ? (
        <a
          href={`/belajar/${langId}/${slug}`}
          class:list={[
            'flex items-center gap-2 rounded-lg px-3 py-2 text-[13.5px] font-medium transition',
            active ? 'bg-primary-soft text-primary-dark' : 'text-ink/80 hover:bg-line/50',
          ]}
        >
          <span class:list={['flex h-4.5 w-4.5 items-center justify-center rounded-full text-[10px]', done ? 'bg-success text-white' : active ? 'bg-primary text-white' : 'bg-line text-muted']}>
            {done ? '✔' : i + 1}
          </span>
          <span class="line-clamp-2">{c.data.title}</span>
        </a>
      ) : (
        <span class="flex items-center gap-2 rounded-lg px-3 py-2 text-[13.5px] font-medium text-muted/60" title="Selesaikan kuis bab sebelumnya">
          <span class="flex h-4.5 w-4.5 items-center justify-center rounded-full bg-line text-[10px]">🔒</span>
          <span class="line-clamp-2">{c.data.title}</span>
        </span>
      );
    })}
  </nav>
  <div class="mt-4 rounded-xl bg-bg p-3 text-xs text-muted">
    Selesaikan kuis tiap bab (min. 70%) untuk mendapat sertifikat.
  </div>
</aside>
